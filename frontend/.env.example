# Copy to .env.local and fill in. Never commit .env.local.

# --- Contract addresses (bắt buộc) ---------------------------------------
# Lấy từ contracts/deployed-addresses-<network>.json sau khi chạy:
#   cd contracts && npx hardhat run scripts/deploy.js --network sepolia
# Thiếu bất kỳ giá trị nào thì app sẽ báo lỗi thay vì gửi tx tới 0x0.
NEXT_PUBLIC_STREAM_CREDIT_ADDRESS=
NEXT_PUBLIC_MOCK_USDC_ADDRESS=
NEXT_PUBLIC_COLLATERAL_NFT_ADDRESS=

# --- MongoDB (bắt buộc cho /api/loans và /api/collaterals) ---------------
# MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=

# --- Thirdweb IPFS (bắt buộc để upload ảnh tài sản thế chấp) -------------
# https://thirdweb.com/dashboard/settings/api-keys
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# --- Mock API (tuỳ chọn) -------------------------------------------------
# Nguồn dữ liệu giao dịch + phân tích Benford. Mặc định localhost:3001.
NEXT_PUBLIC_MOCK_API_URL=http://localhost:3001
