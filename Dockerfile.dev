# Development image for FESEE. Every dependency the project needs lives in
# here, so nothing has to be installed on the host.
FROM node:20-bookworm

# git         - hardhat plugins and some npm packages shell out to it
# python3/make/g++ - node-gyp, for packages with native addons
# curl/ca-certificates - RPC calls, downloading circuit artifacts
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        python3 \
        make \
        g++ \
    && rm -rf /var/lib/apt/lists/*

# The `node` user is uid/gid 1000, which matches the host user, so files the
# container creates are not left root-owned on the host.
USER node

WORKDIR /workspace

# Pre-create every named-volume mount point owned by `node`. Docker seeds a
# fresh named volume from the image's directory, so the volumes inherit this
# ownership rather than defaulting to root — which would make npm install and
# `next build` fail with EACCES.
RUN mkdir -p /workspace/node_modules \
             /workspace/contracts/node_modules \
             /workspace/frontend/node_modules \
             /workspace/mock-api/node_modules \
             /workspace/frontend/.next

# Keep the container alive; work happens through `docker compose exec dev bash`.
CMD ["sleep", "infinity"]
